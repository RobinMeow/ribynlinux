// -*- mode: jsonc -*-
// https://github.com/Alexays/Waybar/wiki/Configuration#minimal-config
{
  // container values
  // "output": ["DP-1"], // desc: from hyprl works. but without the desc: prefix
  // "layer": "top",
  "position": "top", // (top|bottom|left|right)
  // "height": 30, // auto height, when not set
  // "width": 1280, // full width, when not set
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0, // hypr outer-gaps takes care of this
  "spacing": 8, // Gaps between modules
  // Choose the order of the modules
  "modules-left": [
    "clock",
    // TODO: make shorter text and unique
    "hyprland/language",
    "network"
  ],
  "modules-center": ["privacy"],
  "modules-right": [
    // "idle_inhibitor", // disable/enable sleep mode etc
    "battery",
    "backlight", // brightness
    "pulseaudio",
    "cpu",
    "memory",
    // TODO: not working on laptop
    "temperature", // GPU or CPU? I want both
    // "battery#bat2", // NOTE: comment in if I actually have a device with 2 batteries
    "tray"
  ],
  // Modules configuration
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    // if I want someone elses time
    // "timezone": "America/New_York",
    "timezone": "Europe/Berlin",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M, %Y-%m-%d}"
    // "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true
  },
  "memory": {
    "format": "{}% Mem"
  },
  "temperature": {
    // "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format-critical": "{icon} {temperatureC}°C, {temperatureF}°F",
    "format": "{icon} {temperatureC}°C, {temperatureF}°F",
    // TODO: what is each icon?
    "format-icons": ["", "", ""]
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  "battery": {
    "states": {
      "good": 65,
      "warning": 50,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}  {time}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["", "", "", "", ""]
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    // essid "FritzBox .."
    // ipaddr 192.168.178.xxx
    // ifname wlp1s0
    // cidr 24
    // gwaddr 192.168.178.X (I think public IP?)
    "format-wifi": "   {signalStrength}% {essid}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "scroll-step": 5, // 5% per scroll event
    "format": "{icon}   {volume}%  {format_source}",
    "format-bluetooth": "{volume}% {icon}  {format_source}",
    "format-bluetooth-muted": " {icon}  {format_source}",
    "format-muted": "  {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  }
}
