# find history (fzf a history cmd and select it for prompt editing and fire it off)
fh() {
	local choice
	choice=$(cut -d';' -f2 "$HISTFILE" | sort -u | grep '..........' | fzf)
	print -z "$choice"
}

# Then use y instead of yazi to start, and press q to quit, you'll see
# the CWD changed. Sometimes, you don't want to change, press Q to quit.
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd <"$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# shadow hyprmoncfg bin to set the env variable and act as a short alias
function hyprmoncfg() {
	HYPRMONCFG_MONITORS_CONF="$HOME/.config/hypr/hyprmoncfg.lua" command hyprmoncfg "$@"
}

function rrt() {
	cd "$RIBYN_ROOT" || exit
}

function rcd() {
	cd "$( (
		fd --type d . "$RIBYN_ROOT"
	) | fzf)" || exit 1
}

function rr() {
	print -z "$( (
		fd . "$RIBYN_ROOT" --extension=sh
		fd . "$RIBYN_ROOT/bin"
	) | fzf)"
}

ribyn() {
	local cmd="$1"
	if [[ "$cmd" == "state" ]]; then
		shift
		cd "$HOME/ribyns-state" || exit
	elif [[ "$cmd" == "keyboard-feh" ]]; then
		shift
		selected_img="$( (
			fd . "$RIBYN_ROOT/keyboard/glove80" --extension=png
		) | fzf)"
		if [[ -f "$selected_img" ]]; then
			feh "$selected_img"
		fi
	elif [[ "$cmd" == "keyboard-chafa-all" ]]; then
		shift
		chafa "$RIBYN_ROOT/keyboard/glove80/nav-layer.png"
		chafa "$RIBYN_ROOT/keyboard/glove80/symbol-fkeys-layer.png"
	elif [[ "$cmd" == "wezterm-guide" ]]; then
		shift
		"$RIBYN_ROOT/apps/wezterm/wezterm-guide.sh"
	else
		echo "ribyn: unknown key '$1'" >&2
		for k in "${!temp_dirs[@]}"; do
			echo "  $k" >&2
		done
		return 1
	fi
}
complete -W "state wezterm-guide keyboard-feh keyboard-chafa keyboard-chafa-all" ribyn

