#!/usr/bin/env bash
set -euo pipefail

# only have files selectable which have UserSecretsId in them
csproj_file=$(rg -l "UserSecretsId" -g "*.csproj" | fzf)

# csproj_file="$(fd . --extension "csproj" | fzf)"

usersecretsid=$(sed -n 's/.*<UserSecretsId>\(.*\)<\/UserSecretsId>.*/\1/p' "$csproj_file" | xargs)
${EDITOR:-vim} "$HOME/.microsoft/usersecrets/$usersecretsid/secrets.json"

# echo "$csproj_file"
